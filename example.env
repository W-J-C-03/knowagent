# ==================== 复制为 .env 后填写 ====================
# cp .env.example .env
# 注意：.env 内含真实密钥，切勿提交到 Git！

# ---------------------- 大模型（OpenAI 兼容接口） ----------------------
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_API_KEY=<your-llm-api-key>
LLM_DEFAULT_MODEL=deepseek-flash
VL_MODEL=deepseek-flash
LLM_DEFAULT_TEMPERATURE=0.1

# ---------------------- 向量模型 / 重排模型（本地） ----------------------
# 指向 snapshots/master 这一层（内含 config.json、pytorch_model.bin）
BGE_M3_PATH=/path/to/modelscope_cache/models/models/BAAI--bge-m3/snapshots/master
BGE_M3=BAAI/bge-m3
# 必须小写：cpu 或 cuda:0
BGE_DEVICE=cpu
# GPU 可用 1，CPU 必须 0
BGE_FP16=0

BGE_RERANKER_LARGE=/path/to/modelscope_cache/models/rerank/models/BAAI--bge-reranker-large/snapshots/master
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=0

# ---------------------- 模型缓存 ----------------------
MODELSCOPE_CACHE=/path/to/modelscope_cache
MODELSCOPE_OFFLINE=0
HF_HOME=/path/to/huggingface_cache
MINERU_MODEL_SOURCE=modelscope

# ---------------------- Milvus ----------------------
MILVUS_URL=http://127.0.0.1:19530
CHUNKS_COLLECTION=kb_chunks
ITEM_NAME_COLLECTION=kb_item_names
ENTITY_NAME_COLLECTION=kb_graph_entity_names
EMBEDDING_DIM=1024
MILVUS_METRIC_TYPE=COSINE
MILVUS_MIN_COSINE_SCORE=0.75

# ---------------------- MongoDB（会话历史） ----------------------
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=kb002

# ---------------------- MinIO（图片存储） ----------------------
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=<minio-access-key>
MINIO_SECRET_KEY=<minio-secret-key>
MINIO_BUCKET_NAME=knowledge-base-files
MINIO_IMG_DIR=/upload-images
# True=https，False=http（要与 MinIO 实际协议一致）
MINIO_SECURE=False

# ---------------------- MinerU（PDF 解析云端 API） ----------------------
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_API_TOKEN=<your-mineru-api-token>

# ---------------------- DashScope MCP 联网搜索（可选） ----------------------
MCP_DASHSCOPE_BASE_URL_STREAMABLE=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
OPENAI_API_KEY_AL=<your-dashscope-api-key>

# ---------------------- Neo4j（预留，未接入主流程） ----------------------
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<neo4j-password>

# ---------------------- 其他 ----------------------
MD_ROOT_DIR=./temp-files/
ITEM_NAME_DIAG=1

# ===================== 日志 =====================
LOG_CONSOLE_ENABLE=True
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_ENABLE=True
LOG_FILE_LEVEL=INFO
LOG_FILE_RETENTION=7 days
